# AI Gateway environment template.
# Copy to .env for local development: cp .env.example .env
# Values are placeholders only — never commit real secrets.

# Non-secret gateway configuration defaults.
AI_GATEWAY_HOST=127.0.0.1
AI_GATEWAY_PORT=3000

# Provider selection configuration (Phase 4).
# AI_GATEWAY_PROVIDER: provider id to select at startup (default: "deterministic")
# AI_GATEWAY_PROVIDER_TIMEOUT_MS: per-call deadline in ms, must be positive (default: 30000)

# OpenRouter provider configuration (Phase 5).
# These values are read as environment variables at startup (005 FR-028).
# The YAML file `config/gateway.yaml` serves as operator-facing reference documenting default env-var values.
# The API key must be supplied through the variable named by AI_GATEWAY_OPENROUTER_API_KEY_ENV.
AI_GATEWAY_OPENROUTER_ENABLED=true
AI_GATEWAY_OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
AI_GATEWAY_OPENROUTER_API_KEY_ENV="OPENROUTER_API_KEY"

# No .env file is loaded automatically; export these values before starting.
